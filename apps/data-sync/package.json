{
  "name": "@black-diamond/data-sync",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "dependencies": {
    "@black-diamond/core": "workspace:*",
    "@black-diamond/database": "workspace:*"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/index.ts",
    "start": "node --env-file=.env --import tsx src/index.ts",
    "check:database": "node --env-file=.env --import tsx src/checkDatabaseConnection.ts",
    "ensure:database-indexes": "node --env-file=.env --import tsx src/ensureDatabaseIndexes.ts",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
