{
  "name": "@black-diamond/data-sync",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "dependencies": {
    "@black-diamond/core": "workspace:*",
    "@black-diamond/database": "workspace:*"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts daily",
    "start": "pnpm run sync:daily",
    "sync": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "sync:daily": "pnpm run sync -- daily",
    "sync:hourly": "pnpm run sync -- hourly",
    "sync:live": "pnpm run sync -- live",
    "sync:three-hourly": "pnpm run sync -- three-hourly",
    "sync:weekly": "pnpm run sync -- weekly",
    "check:database": "node --env-file=.env --import tsx src/checkDatabaseConnection.ts",
    "ensure:database-indexes": "node --env-file=.env --import tsx src/ensureDatabaseIndexes.ts",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
