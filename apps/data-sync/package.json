{
  "name": "@black-diamond/data-sync",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "dependencies": {
    "@black-diamond/core": "workspace:*",
    "@black-diamond/database": "workspace:*"
  },
  "scripts": {
    "sync:indexes": "node --env-file-if-exists=.env --import tsx src/index.ts indexes",
    "sync:all": "node --env-file-if-exists=.env --import tsx src/index.ts all",
    "backfill": "node --env-file-if-exists=.env --import tsx src/index.ts backfill",
    "backfill:strategy-performances": "node --env-file-if-exists=.env --import tsx src/index.ts strategy-performances",
    "sync:botd": "node --env-file-if-exists=.env --import tsx src/index.ts botd",
    "sync:daily": "node --env-file-if-exists=.env --import tsx src/index.ts daily",
    "sync:hourly": "node --env-file-if-exists=.env --import tsx src/index.ts hourly",
    "sync:live": "node --env-file-if-exists=.env --import tsx src/index.ts live",
    "sync:three-hourly": "node --env-file-if-exists=.env --import tsx src/index.ts three-hourly",
    "sync:weekly": "node --env-file-if-exists=.env --import tsx src/index.ts weekly",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
